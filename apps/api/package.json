{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --import ./dist/instrumentation.js dist/main.js",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "outbox:migrate": "nest-outbox migrate --url \"$DATABASE_URL\"",
    "engine:migrate": "nest-workflows migrate --url \"$DATABASE_URL\"",
    "test:int": "vitest run --config ./vitest.config.int.ts",
    "test:ctk": "vitest run --config ./vitest.config.ctk.ts"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "16.0.5",
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "2.0.1",
    "@nestjs/authentication": "0.1.0",
    "@nestjs/authorization": "0.1.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/idempotency": "0.0.3",
    "@nestjs/mail": "0.0.1",
    "@nestjs/outbox": "0.1.3",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/resilience": "0.0.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/workflows": "0.0.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@openworkflowspec/sdk": "1.0.3-alpha8",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.45.4",
    "express": "5.2.1",
    "jq-wasm": "3.0.0-jq-1.8.2",
    "js-yaml": "5.4.2",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "piscina": "5.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.3.2",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.13",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
