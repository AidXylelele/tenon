# Copy to .env (git-ignored); docker compose reads it, and so does a shell before an app run from source.
# The secrets are files in docker/secrets (see the README). Keep comments on their own lines.

# --- Host ports, each bound to 127.0.0.1
WEB_PORT=3001
API_PORT=53000
POSTGRES_PORT=55432
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025
SANDBOX_PORT=55050
COLLECTOR_PORT=54318
GRAFANA_PORT=58888

# --- go-judge: runs in parallel; a queued run waits within the worker's sandbox budget
SANDBOX_PARALLELISM=8

# --- migrate: seeds the first administrator once, passed as PGOPTIONS="-c tenon.admin_email=${ADMIN_EMAIL}"
ADMIN_EMAIL=admin@example.com

# --- API, workers and web
WEB_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:53000
TRUSTED_ORIGINS=http://localhost:3001
SESSION_COOKIE_SECURE=false
WORKER_REPLICAS=2
# Postgres connections: API pool + WORKER_REPLICAS x worker pool, within max_connections (100) less a reserve
API_DATABASE_POOL_SIZE=10
WORKER_DATABASE_POOL_SIZE=20
# Private addresses outbound calls may reach; the e2e journeys need host.docker.internal's (see apps/api/README.md)
OUTBOUND_ALLOW_LIST=
SMTP_FROM="Tenon <no-reply@tenon.local>"
LOG_LEVEL=info

# --- An app run from source; compose.yaml sets the stand's own addresses, secrets and telemetry
DATABASE_URL=postgres://tenon:$(cat docker/secrets/postgres-password)@127.0.0.1:${POSTGRES_PORT}/tenon
SECRETS_KEY_FILE=${PWD}/docker/secrets/secrets-key
SANDBOX_TOKEN_FILE=${PWD}/docker/secrets/sandbox-token
SANDBOX_URL=http://127.0.0.1:${SANDBOX_PORT}
SMTP_HOST=127.0.0.1
SMTP_PORT=${MAILPIT_SMTP_PORT}
SMTP_STARTTLS=opportunistic
SMTP_USER=
SMTP_PASSWORD=
API_URL=http://127.0.0.1:3000
# false sends telemetry to the stand's collector
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:${COLLECTOR_PORT}
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_RESOURCE_ATTRIBUTES=service.namespace=tenon,deployment.environment.name=local
