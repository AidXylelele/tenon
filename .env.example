# Copy to .env (git-ignored). Values below are placeholders for the local stack only.
# Keep comments on their own lines: Compose and the shell read this file.

# --- Compose interpolation (compose.yaml) ---
POSTGRES_USER=workflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=workflow
# Host ports, all bound to 127.0.0.1: PostgreSQL, SMTP capture, Mailpit web inbox, API container (profile "app")
POSTGRES_PORT=55432
MAILPIT_SMTP_PORT=51025
# required | opportunistic | never (Mailpit has no TLS)
SMTP_STARTTLS=opportunistic
MAILPIT_UI_PORT=58025
API_PORT=53000
# go-judge sandbox (scripts and shell commands)
SANDBOX_PORT=55050

# --- API (host runs: pnpm --filter api dev) ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://workflow:change-me-local-only@127.0.0.1:55432/workflow
# Session cookie Secure attribute; false only for plain http on a host other than localhost
SESSION_COOKIE_SECURE=false
# Base of the links placed in emails (web application)
WEB_BASE_URL=http://127.0.0.1:3001
# Comma-separated origins besides the API's own whose pages may send cookies on state-changing requests (CSRF)
TRUSTED_ORIGINS=http://127.0.0.1:3001
# Comma-separated proxy addresses or CIDR ranges whose x-forwarded-for is trusted; empty: none
TRUSTED_PROXIES=
# on | off: the roles of this process; run several processes with different roles to scale out
HTTP=on
ENGINE_WORKER=on
# on | off: publish outbox messages from this process
OUTBOX_RELAY=on
# 32 random bytes in base64 (openssl rand -base64 32): encrypts user secrets at rest
SECRETS_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Comma-separated addresses or CIDR ranges that outbound calls and deliveries may reach although private; empty: none
OUTBOUND_ALLOW_LIST=
# go-judge REST endpoint
SANDBOX_URL=http://127.0.0.1:55050
# Bearer token go-judge requires (ES_AUTH_TOKEN), at least 32 characters
SANDBOX_TOKEN=local-sandbox-token-change-me-0123456789
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
# required | opportunistic | never (Mailpit has no TLS)
SMTP_STARTTLS=opportunistic
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Workflow Platform <no-reply@workflow.local>"
LOG_LEVEL=info
# OpenTelemetry SDK variables (https://opentelemetry.io/docs/languages/sdk-configuration/)
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=workflow-platform-api
OTEL_EXPORTER_OTLP_ENDPOINT=
