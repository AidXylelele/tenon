      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (tenon_workflow, tenon_execution_kind) (rate(tenon_workflow_executions_total{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{tenon_workflow}} {{tenon_execution_kind}}",
          "range": true,
          "exemplar": false
