          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(sum(rate(tenon_workflow_step_duration_seconds_sum{tenon_step_kind=\"effect\", service_name=~\"$service\"}[$__rate_interval])) / sum(rate(tenon_workflow_step_duration_seconds_count{tenon_step_kind=\"effect\", service_name=~\"$service\"}[$__rate_interval]))) / (sum(rate(tenon_effect_duration_seconds_sum{service_name=~\"$service\"}[$__rate_interval])) / sum(rate(tenon_effect_duration_seconds_count{service_name=~\"$service\"}[$__rate_interval]))) - 1",
