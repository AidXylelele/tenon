            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "(sum by (interpreter_compile_subject) (rate(interpreter_compile_duration_seconds_count{interpreter_compile_phase=\"analyze\", interpreter_compile_subject=\"workflow\", interpreter_compile_outcome=\"refused\", service_name=~\"$service\"}[$__rate_interval])) or sum by (interpreter_compile_subject) (rate(interpreter_compile_duration_seconds_count{interpreter_compile_phase=\"analyze\", interpreter_compile_subject=\"workflow\", service_name=~\"$service\"}[$__rate_interval])) * 0) / sum by (interpreter_compile_subject) (rate(interpreter_compile_duration_seconds_count{interpreter_compile_phase=\"analyze\", interpreter_compile_subject=\"workflow\", service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "refused",
          "range": true,
          "exemplar": false
        }
      ]
    },
