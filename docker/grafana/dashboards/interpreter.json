{
  "uid": "tenon-interpreter",
  "title": "Tenon \u00b7 Interpreter",
  "description": "The interpreter as an engine: compilation by phase, program calls, the CEK machine's work, runs, and its threads.",
  "tags": ["tenon"],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": ["tenon"],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "Tenon",
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total, service_name)",
          "refId": "service"
        },
        "definition": "label_values(traces_spanmetrics_calls_total, service_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Compilation (front end \u2192 back end)",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Compilations per second",
      "description": "RED \u00b7 rate: documents and filters compiled, by outcome (errors are exceptions, refusals are diagnostics).",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (interpreter_compile_subject, interpreter_compile_outcome, error_type) (rate(interpreter_compile_duration_seconds_count{interpreter_compile_phase=\"analyze\", service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{interpreter_compile_subject}} {{interpreter_compile_outcome}} {{error_type}}",
          "range": true,
          "exemplar": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Refused share",
      "description": "The share of workflow compilations the analysis refused.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
